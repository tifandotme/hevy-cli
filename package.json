{
  "name": "@tifan/hevy",
  "version": "0.2.2",
  "description": "Command-line client for the Hevy public API",
  "keywords": [
    "bun",
    "cli",
    "fitness",
    "hevy",
    "workouts"
  ],
  "homepage": "https://github.com/tifandotme/hevy-cli#readme",
  "bugs": "https://github.com/tifandotme/hevy-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tifandotme/hevy-cli.git"
  },
  "bin": {
    "hevy": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "version": "changeset version",
    "release": "changeset publish",
    "generate:openapi-types": "bun run scripts/generate-openapi-types.ts",
    "update:openapi": "bun run scripts/update-openapi.ts"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.5.1",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "undici-types": "^8.10.2"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
