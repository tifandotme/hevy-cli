{
  "name": "@tifan/hevy",
  "version": "0.2.0",
  "description": "Command-line client for the Hevy public API",
  "keywords": [
    "bun",
    "cli",
    "fitness",
    "hevy",
    "workouts"
  ],
  "homepage": "https://github.com/tifandotme/hevy-cli#readme",
  "bugs": "https://github.com/tifandotme/hevy-cli/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tifandotme/hevy-cli.git"
  },
  "bin": {
    "hevy": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --outdir dist --target bun",
    "prepublishOnly": "bun run typecheck && bun test && bun run build",
    "generate:openapi-types": "bun run scripts/generate-openapi-types.ts",
    "update:openapi": "bun run scripts/update-openapi.ts"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.31.0",
    "@types/bun": "^1.3.13",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
