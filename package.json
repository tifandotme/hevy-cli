{
  "name": "hevy-cli",
  "private": true,
  "bin": {
    "hevy": "dist/hevy"
  },
  "type": "module",
  "scripts": {
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "build": "bun build src/cli.ts --compile --outfile dist/hevy",
    "generate:openapi-types": "bun run scripts/generate-openapi-types.ts",
    "update:openapi": "bun run scripts/update-openapi.ts"
  },
  "dependencies": {
    "citty": "^0.2.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.47.0",
    "oxlint": "^1.62.0",
    "typescript": "^6.0.3"
  }
}
